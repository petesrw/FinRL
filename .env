# Forex Trading System Configuration
# Copy this file to .env and fill in your actual values


# =============================================================================
# MT5 BROKER SETTINGS - MULTI-ACCOUNT CONFIGURATION
# =============================================================================
# Primary account (default/main)
MT5_LOGIN=272015671
MT5_PASSWORD= P@ssw0rd
MT5_SERVER=Exness-MT5Trial14

# =============================================================================
# SYMBOL-SPECIFIC MT5 ACCOUNTS
# =============================================================================
# Account 1: EURUSD Trading
MT5_LOGIN_EURUSD=272015671
MT5_PASSWORD_EURUSD= P@ssw0rd
MT5_SERVER_EURUSD=Exness-MT5Trial14

# Account 2: GBPUSD Trading  
MT5_LOGIN_GBPUSD=273250353
MT5_PASSWORD_GBPUSD= P@ssw0rd
MT5_SERVER_GBPUSD=Exness-MT5Trial6

# Account 3: USDJPY Trading
MT5_LOGIN_USDJPY=273886264
MT5_PASSWORD_USDJPY= P@ssw0rd
MT5_SERVER_USDJPY=Exness-MT5Trial6

# Account 4: XAUUSD (Gold) Trading
MT5_LOGIN_XAUUSD=205747830
MT5_PASSWORD_XAUUSD= P@ssw0rd
MT5_SERVER_XAUUSD=Exness-MT5Trial7

# =============================================================================
# ACCOUNT MAPPING FOR SYMBOLS
# =============================================================================
# Map symbols to specific accounts (used by trading system)
SYMBOL_ACCOUNT_MAPPING_EURUSD=EURUSD
SYMBOL_ACCOUNT_MAPPING_GBPUSD=GBPUSD
SYMBOL_ACCOUNT_MAPPING_USDJPY=USDJPY
SYMBOL_ACCOUNT_MAPPING_XAUUSD=XAUUSD

# Enable multi-account trading
ENABLE_MULTI_ACCOUNT_TRADING=true
# =============================================================================
# MT5 INSTALLATION PATHS (Cross-Platform Support)
# =============================================================================
# Main/Default MT5 path
MT5_PATH_WINDOWS_DEFAULT=D:/MetaTraderAccount1/terminal64.exe
MT5_PATH_WINDOWS_APPDATA=%LOCALAPPDATA%\Programs\MetaTrader 5\terminal64.exe
MT5_PATH_WINDOWS_CUSTOM=D:\MetaTraderAccount1\terminal64.exe
MT5_DATA_PATH_WINDOWS=%APPDATA%\MetaQuotes\Terminal

# =============================================================================
# SYMBOL-SPECIFIC MT5 INSTALLATION PATHS
# =============================================================================
# EURUSD Account MT5 Installation
MT5_PATH_EURUSD=D:/MetaTraderAccount1/terminal64.exe
MT5_DATA_PATH_EURUSD=D:/MetaTraderAccount1/MQL5/Data
MT5_CONFIG_PATH_EURUSD=D:/MetaTraderAccount1/config

# GBPUSD Account MT5 Installation  
MT5_PATH_GBPUSD=D:/MetaTraderAccount2/terminal64.exe
MT5_DATA_PATH_GBPUSD=D:/MetaTraderAccount2/MQL5/Data
MT5_CONFIG_PATH_GBPUSD=D:/MetaTraderAccount2/config

# USDJPY Account MT5 Installation
MT5_PATH_USDJPY=D:/MetaTraderAccount3/terminal64.exe
MT5_DATA_PATH_USDJPY=D:/MetaTraderAccount3/MQL5/Data
MT5_CONFIG_PATH_USDJPY=D:/MetaTraderAccount3/config

# XAUUSD Account MT5 Installation
MT5_PATH_XAUUSD=D:/MetaTraderAccount4/terminal64.exe
MT5_DATA_PATH_XAUUSD=D:/MetaTraderAccount4/MQL5/Data
MT5_CONFIG_PATH_XAUUSD=D:/MetaTraderAccount4/config

# =============================================================================
# ALTERNATIVE PATHS FOR DIFFERENT SETUPS
# =============================================================================
# Option 1: Portable MT5 Installations (Recommended)
# MT5_PATH_EURUSD=D:/MT5_Portable/EURUSD/terminal64.exe
# MT5_PATH_GBPUSD=D:/MT5_Portable/GBPUSD/terminal64.exe
# MT5_PATH_USDJPY=D:/MT5_Portable/USDJPY/terminal64.exe
# MT5_PATH_XAUUSD=D:/MT5_Portable/XAUUSD/terminal64.exe

# Option 2: Standard Installations with Different Folders
# MT5_PATH_EURUSD=C:/Program Files/MetaTrader 5 - EURUSD/terminal64.exe
# MT5_PATH_GBPUSD=C:/Program Files/MetaTrader 5 - GBPUSD/terminal64.exe
# MT5_PATH_USDJPY=C:/Program Files/MetaTrader 5 - USDJPY/terminal64.exe
# MT5_PATH_XAUUSD=C:/Program Files/MetaTrader 5 - XAUUSD/terminal64.exe

# Option 3: Same Installation, Different Data Directories
# MT5_PATH_EURUSD=C:/Program Files/MetaTrader 5/terminal64.exe /config:D:/MT5_Configs/EURUSD
# MT5_PATH_GBPUSD=C:/Program Files/MetaTrader 5/terminal64.exe /config:D:/MT5_Configs/GBPUSD  
# MT5_PATH_USDJPY=C:/Program Files/MetaTrader 5/terminal64.exe /config:D:/MT5_Configs/USDJPY
# MT5_PATH_XAUUSD=C:/Program Files/MetaTrader 5/terminal64.exe /config:D:/MT5_Configs/XAUUSD

# macOS MT5 paths (Wine/CrossOver installation)
MT5_PATH_MACOS_WINE=~/.wine/drive_c/Program Files/MetaTrader 5/terminal64.exe
MT5_PATH_MACOS_CROSSOVER=~/Applications/CrossOver.app/Contents/SharedSupport/CrossOver/bin/wine
MT5_PATH_MACOS_CUSTOM=
MT5_DATA_PATH_MACOS=~/.wine/drive_c/users/crossover/Application Data/MetaQuotes/Terminal

# Linux MT5 paths (Wine installation)
MT5_PATH_LINUX_WINE=~/.wine/drive_c/Program Files/MetaTrader 5/terminal64.exe
MT5_PATH_LINUX_PLAYONLINUX=~/.PlayOnLinux/wineprefix/MetaTrader5/drive_c/Program Files/MetaTrader 5/terminal64.exe
MT5_PATH_LINUX_CUSTOM=
MT5_DATA_PATH_LINUX=~/.wine/drive_c/users/$USER/Application Data/MetaQuotes/Terminal

# Auto-detection settings
MT5_AUTO_DETECT_PATH=true
MT5_TIMEOUT_SECONDS=30

# Alternative broker settings (uncomment if needed)
# MT5_LOGIN=987654321
# MT5_PASSWORD=your_live_password
# MT5_SERVER=YourBroker-Live

# =============================================================================
# TRADING PARAMETERS
# =============================================================================
# Default trading symbol
DEFAULT_SYMBOL=USDJPY

# Risk management
RISK_PER_TRADE=0.05
MAX_DRAWDOWN=0.20
MAX_DAILY_TRADES=100
MAX_CONCURRENT_POSITIONS=3

# Target performance
TARGET_WIN_RATE=0.65
TARGET_PROFIT_FACTOR=1.5
TARGET_SHARPE_RATIO=1.2

# =============================================================================
# MODEL SETTINGS
# =============================================================================
# RL Algorithm (PPO, SAC, A2C)
MODEL_TYPE=PPO

# Training parameters
TRAINING_TIMESTEPS=100000
LOOKBACK_WINDOW=100
INITIAL_BALANCE=10000.0

# Model file paths
MODEL_SAVE_PATH=./models/
MODEL_NAME_PREFIX=forex_model

# Data timeframe for training and trading
TIMEFRAME=M5

# =============================================================================
# TRADING SCHEDULE
# =============================================================================
# Trading hours (24-hour format)
TRADING_START_HOUR=0
TRADING_END_HOUR=23

# Days to trade (0=Monday, 6=Sunday)
TRADING_DAYS=0,1,2,3,4

# Timezone
TRADING_TIMEZONE=UTC

# =============================================================================
# TECHNICAL INDICATORS (AUTOMATIC + MANUAL)
# =============================================================================
# Automatic indicator selection (recommended)
AUTO_SELECT_INDICATORS=true
INDICATOR_OPTIMIZATION_METHOD=adaptive  # smart_defaults, adaptive, meta_learning

# Automatic selection parameters
AUTO_INDICATOR_COUNT=8                  # How many indicators to use
AUTO_OPTIMIZATION_PERIOD=1000          # Re-optimize every N trades
AUTO_PERFORMANCE_THRESHOLD=0.65        # Minimum win rate to keep config

# Manual settings (used if AUTO_SELECT_INDICATORS=false)
# ATR settings for TP/SL calculation
ATR_PERIOD=14
SL_ATR_MULTIPLIER=1.5
TP_ATR_MULTIPLIER=2.5

# Moving average periods
SMA_FAST=20
SMA_SLOW=50
EMA_FAST=12
EMA_SLOW=26

# Oscillator settings
RSI_PERIOD=14
STOCH_K_PERIOD=14
STOCH_D_PERIOD=3

# Advanced: Manual overrides (optional, even with auto-selection)
# Uncomment to force specific values
# FORCE_RSI_PERIOD=21
# FORCE_SMA_FAST=25
# FORCE_ATR_PERI

# =============================================================================
# LOGGING AND MONITORING
# =============================================================================
# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
LOG_FILE=forex_trading.log
LOG_MAX_SIZE=10485760
LOG_BACKUP_COUNT=5

# Performance monitoring
SAVE_TRADES_TO_DB=true
DB_FILE=trades.db

# Telegram notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email notifications (optional)
EMAIL_SMTP_SERVER=
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_TO=

# =============================================================================
# SAFETY SETTINGS
# =============================================================================
# Emergency stops
ENABLE_EMERGENCY_STOP=false
MAX_CONSECUTIVE_LOSSES=5
EMERGENCY_STOP_LOSS_AMOUNT=1000.0

# Stop Loss Cooldown System
ENABLE_SL_COOLDOWN=true
SL_COOLDOWN_MINUTES=30

# News filter (avoid trading during high impact news)
AVOID_NEWS_TRADING=true
NEWS_BUFFER_MINUTES=30

# Slippage protection
MAX_SLIPPAGE_PIPS=3
MAX_SPREAD_PIPS=5

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================
# Demo mode (uses simulated data instead of live MT5)
DEMO_MODE=false

# Backtesting settings
BACKTEST_START_DATE=2020-01-01
BACKTEST_END_DATE=2023-12-31
BACKTEST_INITIAL_BALANCE=10000.0

# Debug settings
DEBUG_MODE=false
SAVE_DEBUG_DATA=false
DEBUG_DATA_PATH=./debug/

# =============================================================================
# API SETTINGS (Optional)
# =============================================================================
# Web dashboard settings
ENABLE_WEB_DASHBOARD=false
DASHBOARD_HOST=localhost
DASHBOARD_PORT=8000
DASHBOARD_SECRET_KEY=your_secret_key_here

# REST API settings
ENABLE_REST_API=false
API_HOST=localhost
API_PORT=8001
API_SECRET_KEY=your_api_secret_here

# =============================================================================
# ADVANCED SETTINGS
# =============================================================================
# Multi-symbol trading
ENABLE_MULTI_SYMBOL=true
TRADING_SYMBOLS=EURUSDm,GBPUSDm,USDJPYm,XAUUSD

# Portfolio allocation (if multi-symbol enabled)
PORTFOLIO_ALLOCATION_EURUSD=0.4
PORTFOLIO_ALLOCATION_GBPUSD=0.3
PORTFOLIO_ALLOCATION_USDJPY=0.2
PORTFOLIO_ALLOCATION_XAUUSD=0.1

# Advanced risk management
ENABLE_CORRELATION_FILTER=false
MAX_CORRELATION_THRESHOLD=0.7

# Position sizing method (FIXED, PERCENT_RISK, KELLY, OPTIMAL_F)
POSITION_SIZING_METHOD=PERCENT_RISK

# Kelly criterion settings (if using KELLY method)
KELLY_LOOKBACK_TRADES=100
KELLY_MAX_FRACTION=0.25